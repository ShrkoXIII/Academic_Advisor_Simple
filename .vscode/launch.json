{
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Recommend local - student",
        "type": "debugpy",
        "request": "launch",
        "module": "src.recommend_local",
        "cwd": "${workspaceFolder}",
        "python": "${workspaceFolder}/.venv/Scripts/python.exe",
        "console": "integratedTerminal",
        "justMyCode": true,
        "args": [
          "--candidates", "json/exportdata (14).json",
          "--student-id", "10021.111",
          "--degree-id", "13.111",
          "--part-id", "20251",
          "--min-credits", "12",
          "--max-credits", "18",
          "--batch-size", "20"
        ]
      }
    ]
  }