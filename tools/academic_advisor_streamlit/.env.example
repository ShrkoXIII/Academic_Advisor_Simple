# Copy this file to your Academic_Advisor_Simple repository ROOT as .env
# Do NOT commit your actual .env.

# FastAPI service already implemented in your project
ADVISOR_UI_FASTAPI_URL=http://127.0.0.1:8000
ADVISOR_API_KEY=replace-with-real-service-key
ADVISOR_ADMIN_API_KEY=replace-with-real-admin-key
# If different UI credentials are needed, use ADVISOR_UI_SERVICE_KEY / ADVISOR_UI_ADMIN_KEY.

# University's actual API URLs, NEVER add student IDs into the URL here
ADVISOR_UI_STUDENT_API_URL=https://university.example/api/student
ADVISOR_UI_COURSES_API_URL=https://university.example/api/courses
ADVISOR_UI_HISTORY_API_URL=https://university.example/api/frozen-history

# Configure actual query parameter NAMES. Defaults match BackendClient's Student GET;
# Courses names here are examples; replace with your actual PHP endpoint parameters.
ADVISOR_UI_STUDENT_PARAMS={"student_id":"studentId","part_id":"semesterId"}
ADVISOR_UI_COURSES_PARAMS={"student_id":"studentId","degree_id":"degreeId","part_id":"semesterId"}

# Frozen History endpoint: GET /...?part_id=20261 or POST {"part_id":"20261"}.
ADVISOR_UI_HISTORY_METHOD=GET
ADVISOR_UI_HISTORY_PARAMS={"part_id":"part_id"}

# If upstream PHP requires a Bearer token, set it below.
ADVISOR_UI_BACKEND_TOKEN=

# If the university API expects custom HTTP headers like 'token' and 'user',
# configure their EXACT names here. These are sent ONLY to university APIs,
# not to our local FastAPI service. Do not also set Bearer above unless needed.
# Example: ADVISOR_UI_BACKEND_HEADERS={"token":"your-token","user":"your-username"}
ADVISOR_UI_BACKEND_HEADERS={}
ADVISOR_UI_HTTP_TIMEOUT=20

# Optional: path to trusted, documented academic evidence *per source*.
# See integration_context.example.json; do not put invented numbers in it.
# ADVISOR_UI_INTEGRATION_CONTEXT_FILE=config/streamlit_integration_context.json
